# Environment Variables for Production
NODE_ENV=production
PORT=5000

# MongoDB Configuration - Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/social-learning-notes

# JWT Configuration - Generate a strong secret key
JWT_SECRET=your-super-secure-jwt-secret-key-for-production-change-this
JWT_EXPIRE=7d

# Cloudinary Configuration - Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# CORS Configuration - Update with your deployed frontend URL
FRONTEND_URL=https://your-frontend-domain.vercel.app
